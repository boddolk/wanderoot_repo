// Діаграма станів маршруту (патерн State)
digraph RouteState {
  graph [rankdir=LR, fontname="Liberation Serif", nodesep=0.8, ranksep=1.3, pad=0.2];
  node  [fontname="Liberation Serif", fontsize=16, shape=box, style="rounded", width=1.8, height=0.6];
  edge  [fontname="Liberation Serif", fontsize=14, arrowhead=vee];
  start [shape=circle, style=filled, fillcolor=black, label="", width=0.25, height=0.25];
  fin   [shape=doublecircle, style=filled, fillcolor=black, label="", width=0.18, height=0.18];
  draft [label="Чернетка\n(DRAFT)"];
  pub   [label="Опубліковано\n(PUBLISHED)"];
  hid   [label="Приховано\n(HIDDEN)"];
  start -> draft [label="create() / import()"];
  draft -> draft [label="update(), setWaypoints()"];
  draft -> pub   [label="publish()\n[title ≠ ∅, waypoints ≥ 2]"];
  pub   -> draft [label="unpublish()"];
  pub   -> hid   [label="hide(reason)\n[роль ≥ MODERATOR]"];
  hid   -> pub   [label="restore()\n[роль ≥ MODERATOR]"];
  draft -> fin   [label="delete()"];
}
