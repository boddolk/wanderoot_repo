// Діаграма варіантів використання WandeRoot (To-Be). Рендер: neato -n2 (фіксовані координати)
digraph UseCases {
  graph [layout=neato, splines=line, fontname="Liberation Serif", fontsize=18, pad=0.3, outputorder=edgesfirst, overlap=true];
  node  [fontname="Liberation Serif", fontsize=16, pin=true];
  edge  [fontname="Liberation Serif", fontsize=14, arrowsize=0.9];

  // Межа системи
  boundary [shape=box, label="", width=8.6, height=13.6, pos="7.15,6.2!", penwidth=1.5];
  sysname  [shape=plaintext, label="Система WandeRoot", fontsize=18, pos="4.3,12.75!"];

  // ---- Актори ----
  node [shape=none, image="actor.png", imagescale=true, width=0.55, height=1.0, fixedsize=true, labelloc=b, label=""];
  Guest [pos="0.4,11.35!"]; User [pos="0.4,7.0!"]; Moder [pos="0.4,2.35!"]; Admin [pos="0.4,0.0!"];
  node [shape=plaintext, image="", width=0, height=0, fixedsize=false, fontsize=16];
  lGuest [label="Гість", pos="0.4,10.62!"]; lUser [label="Користувач", pos="0.4,6.27!"];
  lModer [label="Модератор", pos="0.4,1.62!"]; lAdmin [label="Адміністратор", pos="0.55,-0.73!"];

  // ---- Прецеденти ----
  node [shape=ellipse, width=2.75, height=0.52, fixedsize=true, fontsize=15];
  uc_view   [label="Переглядати маршрути",   pos="4.6,12.3!"];
  uc_search [label="Шукати маршрути",        pos="4.6,11.65!"];
  uc_reg    [label="Зареєструватися",        pos="4.6,11.0!"];
  uc_login  [label="Увійти в систему",       pos="4.6,10.35!"];

  uc_create [label="Створити маршрут",       pos="4.6,9.5!"];
  uc_edit   [label="Редагувати маршрут",     pos="4.6,8.2!"];
  uc_pub    [label="Опублікувати маршрут",   pos="4.6,7.55!"];
  uc_exp    [label="Експортувати маршрут",   pos="4.6,6.9!"];
  uc_poi    [label="Запропонувати POI",      pos="4.6,6.25!"];
  uc_rate   [label="Оцінити маршрут",        pos="4.6,5.6!"];
  uc_comm   [label="Коментувати маршрут",    pos="4.6,4.95!"];
  uc_compl  [label="Поскаржитися",           pos="4.6,4.3!"];
  uc_notif  [label="Переглядати сповіщення", pos="4.6,3.65!"];

  uc_dur    [label="Розрахувати тривалість", pos="9.0,8.6!"];
  uc_imp    [label="Імпортувати маршрут",    pos="4.6,8.85!"];
  uc_nav    [label="Відкрити в навігаторі",  pos="9.0,6.9!"];
  uc_filter [label="Перевірити текст",       pos="9.0,4.95!"];

  uc_review [label="Розглянути скаргу",      pos="4.6,2.85!"];
  uc_appr   [label="Затвердити POI",         pos="4.6,1.55!"];
  uc_hide   [label="Приховати контент",      pos="4.6,2.2!"];
  uc_role   [label="Призначити роль",        pos="4.6,0.0!"];
  uc_block  [label="Заблокувати користувача",pos="9.0,1.2!"];

  // Узагальнення акторів
  edge [arrowhead=onormal, style=solid, arrowsize=1.3];
  User:n -> lGuest:s; Moder:n -> lUser:s; Admin:n -> lModer:s;

  // Асоціації
  edge [arrowhead=none, style=solid, arrowsize=0.9, headport=w];
  Guest -> {uc_view uc_search uc_reg uc_login};
  User  -> {uc_create uc_edit uc_pub uc_exp uc_poi uc_rate uc_comm uc_compl uc_notif uc_imp};
  Moder -> {uc_review uc_appr uc_hide};
  Admin -> {uc_role uc_block};

  // include / extend
  edge [style=dashed, arrowhead=vee, headport=c];
  uc_create -> uc_dur    [xlabel="«include»"];
  uc_edit   -> uc_dur    [xlabel="«include»"];
  uc_comm   -> uc_filter [xlabel="«include»"];
  uc_imp:e  -> uc_create:e [label="  «extend»", headport=e, tailport=e];
  uc_nav    -> uc_exp    [xlabel="«extend»"];
  uc_hide:e -> uc_review:e [label="  «extend»", headport=e, tailport=e];
  uc_block  -> uc_review [xlabel="«extend»"];
}
